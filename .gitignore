*.gba
*.sav
.DS_Store

# Per-file test timings, rewritten by every `rake test:parallel` to balance the next one.
# Local by nature: it changes on every run, so committing it would mean a conflicting diff
# on every merge, and all a fresh clone loses is one unbalanced run before it builds its own.
.test_timings.json

# Not committed — a fresh resolve each time, since the framework is pulled from git.
Gemfile.lock

# What `rake build:profile` leaves: a sampler dump and the JSON speedscope.org reads. A
# reading is of one machine on one day, so it is yours and not the repository's.
tmp/

# `bundle config --local local.ruby-gba ../ruby-gba` lands here, and it is an absolute path on
# whichever machine ran it. The Gemfile says how to set it; where yours lives is your business.
.bundle/

# Personal Claude Code settings (permissions, local overrides) — not shared config.
.claude/settings.local.json

# Local agent notes, holding everything about the issue tracker. That tracker is internal to
# one machine, so a checked-in file must not name it; this is where it goes instead.
CLAUDE.local.md

# No copy of Wolfenstein's data is ever committed — not what you drop in, not what we convert
# out of it. The readers are committed; what they read is not.
data/
assets/
*.WL1
*.WL6
*.SOD
*.SDM
*.EXE
*.exe
*.pal

wolf3d.yml
!wolf3d.example.yml
